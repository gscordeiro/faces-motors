<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.1"
	xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
		https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd">

	<persistence-unit name="default" transaction-type="JTA">

		<class>dev.gscordeiro.facesmotors.entities.Automovel</class>
		<class>dev.gscordeiro.facesmotors.entities.Cor</class>
		<class>dev.gscordeiro.facesmotors.entities.Foto</class>
		<class>dev.gscordeiro.facesmotors.entities.Marca</class>
		<class>dev.gscordeiro.facesmotors.entities.Modelo</class>


		<shared-cache-mode>ENABLE_SELECTIVE</shared-cache-mode>
		<validation-mode>AUTO</validation-mode>

		<properties>
			<!--
			<property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:facesmotors;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE" />
			<property name="jakarta.persistence.jdbc.user" value="sa" />
			<property name="jakarta.persistence.jdbc.password" value="" />
			-->
			<property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect" />

			<property name="hibernate.hbm2ddl.auto" value="update" />
			<property name="hibernate.show_sql" value="true" />
			<property name="hibernate.format_sql" value="true" />
			<property name="hibernate.cache.use_second_level_cache" value="true"/>
			<property name="hibernate.cache.use_query_cache" value="true"/>
		</properties>
	</persistence-unit>

</persistence>
